# ---- Supabase ----
# Project URL and public anon key (safe to expose — RLS governs access)
NEXT_PUBLIC_SUPABASE_URL=https://drkibqzdrgyqgsntaknm.supabase.co   # opdeskver2 (shared with OpDesk)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY, never prefix with NEXT_PUBLIC_. Used to insert enquiries.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Site URL (used to build absolute canonical URLs for SEO & social sharing) ----
# Route22: https://www.route22zululand.co.za   ZAtours: its own live origin
NEXT_PUBLIC_SITE_URL=https://www.route22zululand.co.za

# ---- Resend (form email routing) ----
RESEND_API_KEY=re_your_key
# The address enquiries are SENT TO (your Zoho mailbox, e.g. info@route22zululand.co.za)
ENQUIRY_TO_EMAIL=central@opdesk.app
# The verified sender domain in Resend (e.g. no-reply@route22zululand.co.za)
ENQUIRY_FROM_EMAIL=no-reply@route22zululand.co.za

# ---- Admin panel (/admin) ----
# Shared password gating /admin — change this to something strong.
ADMIN_PASSWORD=change-me-before-launch
# Random secret used to sign the admin session cookie. Generate one with:
# `openssl rand -hex 32`
ADMIN_SESSION_SECRET=generate-a-long-random-string

# ---- Directory front end ----
# Which site this deployment is: route22 | zatours. Same codebase and
# database; decides which listings show (dir_listings.sites) and how
# enquiries/leads are tagged.
NEXT_PUBLIC_SITE_ID=route22
# Route22 project only: ZAtours' live origin. When set, Route22 listing pages
# that are also on ZAtours point their canonical at ZAtours (and drop out of
# Route22's sitemap). Leave EMPTY until ZAtours is live on its domain.
NEXT_PUBLIC_ZATOURS_URL=
# ZAtours project only: Route22's origin for cross-links (default below).
NEXT_PUBLIC_ROUTE22_URL=https://www.route22zululand.co.za
# Reviews need separate visitor auth (shared OpDesk auth would create OpDesk
# profiles for every reviewer). Keep false until that's built.
NEXT_PUBLIC_REVIEWS_ENABLED=false

# ---- POPIA privacy notice (/privacy) ----
# Company, Information Officer and registration details are in lib/legal.ts.
# Optional override for where privacy requests go (default central@opdesk.app).
NEXT_PUBLIC_PRIVACY_EMAIL=
